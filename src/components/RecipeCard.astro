---
interface Props {
  id: string;
  title: string;
  description: string;
  category: string;
  ingredients: string[];
  steps?: string[];
  servings?: number;
  yield?: string;
  prepTime?: string;
  cookTime?: string;
  chillTime?: string;
  tip?: string;
}

const { id, title, description, category, ingredients, steps = [], tip, ...rest } = Astro.props;

const stats = [
  rest.yield ?? (rest.servings ? `Serves ${rest.servings}` : undefined),
  rest.prepTime && `Prep ${rest.prepTime}`,
  rest.cookTime && `Bake ${rest.cookTime}`,
  rest.chillTime && `Chill ${rest.chillTime}`,
].filter(Boolean) as string[];
---

<details class="group rounded-lg border border-neutral-800 bg-neutral-900/40 open:border-neutral-600 transition-colors">
  <summary class="list-none cursor-pointer p-6 flex items-start justify-between gap-4 [&::-webkit-details-marker]:hidden">
    <div>
      <div class="font-mono text-xs uppercase tracking-wider text-accent mb-2">{category}</div>
      <h2 class="font-semibold text-neutral-100 mb-1">{title}</h2>
      <p class="text-sm text-neutral-400 mb-3">{description}</p>
      <div class="flex flex-wrap gap-2">
        {stats.map((s) => <span class="text-xs px-2 py-0.5 rounded-full bg-neutral-800 text-neutral-400">{s}</span>)}
      </div>
    </div>
    <span class="text-neutral-500 text-xl leading-none transition-transform group-open:rotate-45 shrink-0" aria-hidden="true">+</span>
  </summary>

  <div class="px-6 pb-6 grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] border-t border-neutral-800 pt-6">
    <div>
      <h3 class="font-mono text-xs uppercase tracking-wider text-neutral-500 mb-3">Ingredients</h3>
      <ul class="space-y-2 text-sm text-neutral-200">
        {ingredients.map((ing) => (
          <li class="flex gap-2"><span class="text-accent">•</span><span>{ing}</span></li>
        ))}
      </ul>
    </div>
    <div>
      <h3 class="font-mono text-xs uppercase tracking-wider text-neutral-500 mb-3">Steps</h3>
      {steps.length > 0 ? (
        <ol class="space-y-3 text-sm text-neutral-200">
          {steps.map((step, i) => (
            <li class="flex gap-3">
              <span class="font-mono text-xs text-accent mt-0.5 shrink-0 w-5">{i + 1}.</span>
              <span>{step}</span>
            </li>
          ))}
        </ol>
      ) : (
        <p class="text-sm text-neutral-400">See the full recipe for method.</p>
      )}
      {tip && <p class="mt-5 text-sm text-neutral-400 border-l-2 border-accent pl-3">{tip}</p>}
      <a href={`/hobbies/baking/${id}`} class="inline-block mt-5 text-xs text-neutral-500 hover:text-neutral-200">Open full page →</a>
    </div>
  </div>
</details>
