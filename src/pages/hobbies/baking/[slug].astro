---
import { getCollection, render } from "astro:content";
import ContentLayout from "../../../layouts/ContentLayout.astro";
import PasswordGate from "../../../components/PasswordGate.astro";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");
  return recipes.map((recipe) => ({ params: { slug: recipe.id }, props: { recipe } }));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
const { title, description, servings, prepTime, cookTime, chillTime, ingredients, steps, tip } = recipe.data;
const stats = [
  ["Prep", prepTime],
  ["Cook", cookTime],
  ["Chill", chillTime],
  ["Serves", recipe.data.yield ?? servings],
].filter(([, v]) => v) as [string, string | number][];
---

<ContentLayout title={title} description={description} backHref="/hobbies/baking" backLabel="Baking">
  <div class="not-prose flex flex-wrap gap-4 mb-8 text-sm">
    {stats.map(([label, value]) => (
      <div class="p-4 rounded-lg bg-neutral-900 border border-neutral-800 min-w-28">
        <div class="text-neutral-500 mb-1">{label}</div>
        <div class="text-neutral-200 font-medium">{value}</div>
      </div>
    ))}
  </div>

  <h2>Ingredients</h2>
  <ul>
    {ingredients.map((ing) => <li>{ing}</li>)}
  </ul>

  <h2>Method</h2>
  {steps && steps.length > 0 ? (
    <ol>{steps.map((step) => <li>{step}</li>)}</ol>
  ) : recipe.data.password ? (
    <PasswordGate password={recipe.data.password}>
      <Content />
    </PasswordGate>
  ) : (
    <Content />
  )}
  {tip && <p><em>{tip}</em></p>}
</ContentLayout>
